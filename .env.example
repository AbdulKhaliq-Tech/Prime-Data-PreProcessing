# PrimeProcessing.com — Environment Configuration (EXAMPLE ONLY)
# Copy this file to ".env" and fill in real values for your local environment.
# Never commit a real ".env" file. Never put real secrets in this example file.

# Application
APP_NAME=PrimeProcessing.com
APP_ENV=development
APP_DEBUG=true
SECRET_KEY=change-me-in-a-real-env-file

# Server
HOST=0.0.0.0
PORT=8000

# Logging
LOG_LEVEL=INFO

# Future processing limits (placeholders — not enforced until later phases)
MAX_UPLOAD_SIZE_MB=50
